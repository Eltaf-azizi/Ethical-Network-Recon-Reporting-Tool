<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Recon Report — {{ report.target }}</title>
<style>
  :root{
    --bg:#f4f6f9; --panel:#ffffff; --ink:#111827; --muted:#6b7280;
    --line:#e5e7eb; --accent:#1d4ed8; --ok:#059669; --warn:#d97706; --bad:#dc2626;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);
       font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
  .wrap{max-width:1080px;margin:0 auto;padding:32px 20px 80px}
  header.hero{background:linear-gradient(135deg,#0f172a,#1e3a8a);color:#fff;
              border-radius:14px;padding:28px 30px;margin-bottom:24px}
  header.hero h1{margin:0 0 6px;font-size:26px;letter-spacing:.2px}
  header.hero .sub{opacity:.85;font-size:14px}
  .badge{display:inline-block;background:rgba(255,255,255,.15);
         border:1px solid rgba(255,255,255,.3);
         padding:3px 10px;border-radius:999px;font-size:12px;
         margin-right:6px;margin-top:10px}
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
        gap:14px;margin-bottom:24px}
  .card{background:var(--panel);border:1px solid var(--line);
        border-radius:12px;padding:16px 18px}
  .card .label{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
  .card .value{font-size:24px;font-weight:650;margin-top:4px}
  section{background:var(--panel);border:1px solid var(--line);
          border-radius:12px;padding:22px 24px;margin-bottom:22px}
  section h2{margin:0 0 14px;font-size:17px;letter-spacing:.02em;
             padding-bottom:10px;border-bottom:1px solid var(--line)}
  table{width:100%;border-collapse:collapse;font-size:14px}
  th,td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--line);vertical-align:top}
  th{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);background:#fafbfc}
  tr:last-child td{border-bottom:none}
  code,pre{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12.5px}
  pre{background:#0f172a;color:#e2e8f0;padding:14px 16px;border-radius:9px;overflow-x:auto;
      white-space:pre-wrap;word-break:break-word}
  .pill{display:inline-block;padding:2px 9px;border-radius:999px;font-size:12px;font-weight:600}
  .pill.open{background:#ecfdf5;color:var(--ok)}
  .pill.closed{background:#f3f4f6;color:var(--muted)}
  .pill.filtered{background:#fffbeb;color:var(--warn)}
  .pill.error{background:#fef2f2;color:var(--bad)}
  .notice{border-left:4px solid var(--warn);background:#fffbeb;
          padding:12px 16px;border-radius:8px;font-size:13.5px;margin:10px 0}
  .notice.ok{border-left-color:var(--ok);background:#ecfdf5}
  .muted{color:var(--muted)}
  details{margin-top:10px}
  summary{cursor:pointer;font-weight:600;color:var(--accent)}
  footer{text-align:center;color:var(--muted);font-size:12.5px;margin-top:30px}
  @media print{
    body{background:#fff}
    section,.card{break-inside:avoid;box-shadow:none}
    header.hero{background:#0f172a !important;
                -webkit-print-color-adjust:exact;print-color-adjust:exact}
  }
</style>
</head>
<body>
<div class="wrap">
  {% include "partials/header.html.j2" %}
  {% include "partials/summary.html.j2" %}
  {% include "partials/authorization.html.j2" %}

  {% if report.os_hint %}
    {% include "partials/os_hint.html.j2" %}
  {% endif %}

  {% include "partials/open_ports.html.j2" %}
  {% include "partials/full_results.html.j2" %}
  {% include "partials/methodology.html.j2" %}
  {% include "partials/ethics.html.j2" %}
  {% include "partials/footer.html.j2" %}
</div>
</body>
</html>